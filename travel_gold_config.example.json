{
  "silver_table": "lake.silver.location_events",
  "gold_table": "lake.gold.travel_observations",
  "staging_root": "hdfs:///apps/travel-gold/publication",
  "gold_buckets": 256,
  "silver_bucket_column": "silver_bucket",
  "silver_bucket_count": 512,
  "calculation_bucket_batch": 16,
  "shuffle_partitions": 400,
  "materialize_scoring": true,
  "fail_on_rejected": true,
  "cleanup_checkpoints": true,
  "max_records_per_file": 1000000,
  "hive_table": "prod_gold.travel_observations",
  "hive_root": "hdfs:///apps/travel-gold/hive",
  "max_hive_partitions_per_run": 20000,
  "enable_additive_schema_evolution": false,
  "columns": {
    "entity_key": "entity_key",
    "event_id": "silver_event_id",
    "event_type": "event_type",
    "valid_from": "valid_from",
    "valid_to": "valid_to",
    "country": "country_code",
    "country_from": "country_from",
    "country_to": "country_to",
    "raw_identifier": "raw_identifier",
    "identifier_type": "identifier_type",
    "identifier_namespace": null,
    "identifier_confidence": "identity_confidence",
    "logic_confidence": "logic_confidence",
    "occurrence_count": "evidence_count",
    "source": "source_id",
    "dependency_group": "dependency_group",
    "source_confidence": "source_confidence",
    "is_resolved": "is_resolved",
    "timestamp_format": null
  },
  "scoring": {
    "logic_weight": 0.25,
    "identifier_weight": 0.35,
    "occurrence_weight": 0.1,
    "convergence_weight": 0.3,
    "identifier_scale": 100,
    "occurrence_saturation": 10,
    "convergence_saturation": 2,
    "bonus_levels": [[24, 0.15], [72, 0.05]],
    "presence_cap": 0.85,
    "transition_cap": 0.9,
    "enable_temporal_bonus": true,
    "include_score_components": true,
    "dependency_groups": {},
    "country_aliases": {}
  },
  "elasticsearch": {
    "endpoints": ["https://elastic.exemple.fr:9200"],
    "index": "travel-observations-v1",
    "alias": "travel-observations",
    "primary_shards": 1,
    "replicas": 1,
    "initial_load_replicas": 0,
    "refresh_interval": "30s",
    "auth": "api_key",
    "api_key_env": "TRAVEL_ES_API_KEY",
    "ca_file": null,
    "request_timeout_seconds": 60,
    "max_retries": 6,
    "backoff_seconds": 1,
    "max_backoff_seconds": 30,
    "max_bulk_documents": 1000,
    "max_bulk_bytes": 5242880,
    "max_document_bytes": 10485760,
    "writer_partitions": 8,
    "source_columns": null,
    "index_sort": false
  }
}
